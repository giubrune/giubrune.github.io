---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { SOFTWARE } from "@consts"

const items = (await getCollection("software")).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order)
---

<PageLayout title={SOFTWARE.TITLE} description={SOFTWARE.DESCRIPTION}>
  <TopLayout title={SOFTWARE.TITLE}>
    <p class="page-lede">
      I develop extensions for the <a class="link" href="https://www.pc-progress.com/" target="_blank" rel="noopener">HYDRUS</a> software packages
      for simulating water flow, heat and solute transport in variably saturated porous media, as well as open-source Python tools for running HYDRUS in scripted workflows.
    </p>
  </TopLayout>
  <BottomLayout>
    <div class="grid gap-4">
      {items.map((s) => (
        <article class="card flex flex-col sm:flex-row gap-4 sm:items-start">
          <div class="flex-1">
            <div class="eyebrow">{s.data.kind}</div>
            <h2 class="mt-1 font-serif text-xl font-semibold"><a href={`/software/${s.id}`} class="hover:text-accent-700 dark:hover:text-accent-300">{s.data.title}</a></h2>
            <p class="mt-1 text-stone-600 dark:text-stone-400">{s.data.summary}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">{s.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
          <div class="flex sm:flex-col gap-2 shrink-0">
            <a href={`/software/${s.id}`} class="btn">Details</a>
            {s.data.homepage && <a href={s.data.homepage} target="_blank" rel="noopener" class="btn"><svg class="size-4 stroke-current"><use href="/ui.svg#external"/></svg>Homepage</a>}
            {s.data.docsUrl && <a href={s.data.docsUrl} target="_blank" rel="noopener" class="btn"><svg class="size-4 stroke-current"><use href="/ui.svg#external"/></svg>Docs</a>}
          </div>
        </article>
      ))}
    </div>
  </BottomLayout>
</PageLayout>
