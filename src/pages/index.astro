---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import PubItem from "@components/PubItem.astro"
import ResearchMap from "@components/ResearchMap.astro"
import SoilMoistureMap from "@components/SoilMoistureMap.astro"
import SocialLinks from "@components/SocialLinks.astro"
import { SITE } from "@consts"
import { publications } from "@lib/publications"
import { researchFields } from "@data/cv"
import { formatDate } from "@lib/utils"

const selected = publications.filter((p) => p.selected)
const software = (await getCollection("software")).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order)
const news = (await getCollection("news")).filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3)
---

<PageLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <!-- Hero -->
  <section class="pt-28 sm:pt-32 pb-12 border-b border-stone-200 dark:border-stone-800 bg-gradient-to-b from-accent-50/70 to-transparent dark:from-accent-900/20">
    <Container size="wide">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center gap-8">
        <div class="flex-1">
          <p class="eyebrow">{SITE.ROLE} · University of Calabria</p>
          <h1 class="mt-2 font-serif text-4xl sm:text-5xl font-semibold tracking-tight">{SITE.AUTHOR}</h1>
          <p class="mt-4 text-lg leading-relaxed text-stone-600 dark:text-stone-400 max-w-3xl">
            I study how water, heat and solutes move through the <strong class="font-semibold text-stone-800 dark:text-stone-200">vadose zone</strong>,
            build physically based numerical models of these processes, and use Bayesian inference to understand what data can tell us about them.
            I also develop modules for the <strong class="font-semibold text-stone-800 dark:text-stone-200">HYDRUS</strong> software packages.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href="/publications" class="btn-primary">Publications</a>
            <a href="/software" class="btn">Software</a>
          </div>
        </div>
        <!-- Replace with <img src="/photo.jpg" ...> once a portrait is available -->
        <div class="shrink-0 size-36 sm:size-44 rounded-full grid place-items-center bg-accent-700 dark:bg-accent-800 text-white font-serif text-5xl font-semibold ring-4 ring-white dark:ring-stone-900 shadow-sm" aria-hidden="true">GB</div>
      </div>
    </Container>
  </section>

  <Container size="wide">
    <!-- About -->
    <section class="mt-12 grid gap-10 md:grid-cols-[1fr_18rem] lg:gap-14">
      <div>
        <h2 class="section-title">About</h2>
        <div class="space-y-4 leading-relaxed">
          <p>
            I am an Associate Professor in the Department of Civil Engineering at the University of Calabria, Italy.
            My research is rooted in soil physics and vadose zone hydrology. It ranges from green roofs and permeable pavements
            to agricultural hillslopes, managed aquifer recharge, and the uptake of contaminants by plants. Throughout, I combine
            experiments and monitoring data with mechanistic models of variably saturated flow and reactive transport.
          </p>
          <p>
            A recurring question in my work is how complex a model should be, and how much information the available data
            actually contain. I address it with Bayesian calibration, model selection, global optimization, and uncertainty analysis.
          </p>
          <p>
            Before joining the University of Calabria in 2023 through the “Rita Levi Montalcini” program, I was Assistant Professor and then
            Senior Research Scientist at the Institute of Soil Physics and Rural Water Management of BOKU University in Vienna. Earlier, I held
            postdoctoral positions at UC Davis, the Czech University of Life Sciences in Prague, and the University of Brescia.
            I serve as Associate Editor of the <em>Journal of Hydrology</em>, <em>Vadose Zone Journal</em>, and the
            <em>Soil Science Society of America Journal</em>.
          </p>
        </div>
      </div>
      <aside class="space-y-6">
        <div>
          <h2 class="eyebrow mb-3">Contact & profiles</h2>
          <SocialLinks variant="list" class="[&_span.w-28]:hidden" />
        </div>
        <SoilMoistureMap compact />
      </aside>
    </section>

    <!-- News -->
    <section class="mt-14">
      <div class="flex items-baseline justify-between section-title">
        <h2 class="font-serif">News</h2>
        <a href="/news" class="text-sm font-sans font-normal link no-underline">All news →</a>
      </div>
      <ul class="divide-y divide-stone-200 dark:divide-stone-800">
        {news.map((n) => (
          <li class="py-3 flex flex-col sm:flex-row sm:gap-6">
            <time class="text-sm text-stone-500 sm:w-32 shrink-0" datetime={n.data.date.toISOString()}>{formatDate(n.data.date, "month")}</time>
            <a href={`/news/${n.id}`} class="hover:text-accent-700 dark:hover:text-accent-300">
              <span class="font-medium text-stone-900 dark:text-stone-100">{n.data.title}</span>
              <span class="block text-sm text-stone-600 dark:text-stone-400">{n.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>


    <!-- Research themes -->
    <section class="mt-14">
      <h2 class="section-title">Research themes</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {researchFields.map((f) => (
          <a href={`/publications?topic=${f.topic}`} class="card hover:border-accent-400 dark:hover:border-accent-600 transition-colors group">
            <h3 class="font-serif text-lg font-semibold group-hover:text-accent-700 dark:group-hover:text-accent-300">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{f.text}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Research map -->
    <section class="mt-14">
      <h2 class="section-title">Where the research happens</h2>
      <ResearchMap />
    </section>

    <!-- Selected publications -->
    <section class="mt-14">
      <div class="flex items-baseline justify-between section-title">
        <h2 class="font-serif">Selected publications</h2>
        <a href="/publications" class="text-sm font-sans font-normal link no-underline">All publications →</a>
      </div>
      <ul>{selected.map((p) => <PubItem pub={p} showTopics={false} />)}</ul>
    </section>

    <!-- Software -->
    <section class="mt-14">
      <div class="flex items-baseline justify-between section-title">
        <h2 class="font-serif">Software</h2>
        <a href="/software" class="text-sm font-sans font-normal link no-underline">Details →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {software.map((s) => (
          <a href={`/software/${s.id}`} class="card !p-4 hover:border-accent-400 dark:hover:border-accent-600 transition-colors group">
            <div class="eyebrow !text-stone-500">{s.data.kind}</div>
            <div class="mt-1 font-serif font-semibold text-stone-900 dark:text-stone-100 group-hover:text-accent-700 dark:group-hover:text-accent-300">{s.data.title}</div>
            <div class="mt-1 text-sm text-stone-600 dark:text-stone-400">{s.data.summary}</div>
          </a>
        ))}
      </div>
    </section>
  </Container>
</PageLayout>
