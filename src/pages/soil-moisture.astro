---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Container from "@components/Container.astro"
import SoilMoistureMap from "@components/SoilMoistureMap.astro"
import { loadSoilMoisture } from "@lib/soilMoisture"

const data = loadSoilMoisture()
const updated = data ? new Date(data.generated).toLocaleString("en-GB", { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Rome" }) : null
---

<PageLayout title="Calabria soil moisture" description="How wet is the soil in Calabria today? Daily modelled water content of the top 28 cm for all 404 municipalities, over the last 31 days.">
  <TopLayout>
    <p class="eyebrow">Live tool · updated daily</p>
    <h1 class="page-heading mt-1">How wet is Calabria's soil today?</h1>
    <p class="page-lede">
      The water stored in the top 28 cm of soil controls how much rain soaks in or runs off, how much water crops can use, and how much can drain towards groundwater.
      This map shows its daily value for each of Calabria's 404 municipalities over the last 31 days. Press play to watch storms wet the soil and the soil dry out again.
    </p>
  </TopLayout>
  <Container size="wide">
    <SoilMoistureMap />
  </Container>
  <BottomLayout>
    <section class="mt-12 grid gap-8 md:grid-cols-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
      <div>
        <h2 class="section-title !text-xl">How to read it</h2>
        <p>
          Values are <strong class="text-stone-800 dark:text-stone-200">volumetric water content</strong>: the volume of water per volume of soil (m³/m³).
          Roughly, values below 0.15 mean dry soil, and values above 0.35 mean soil close to saturation, where further rain is more likely to run off.
          What counts as dry or wet depends on soil texture, so the map is most informative for <em>changes over time</em> at a given place.
        </p>
        <p class="mt-3">
          The value shown is the depth-weighted average of two model layers, (7·θ<sub>0–7 cm</sub> + 21·θ<sub>7–28 cm</sub>) / 28, averaged over each day.
          Each municipality is represented by the model grid cell at its geographic centre. Cells the model treats as water or sealed surface are shown as “no data”.
        </p>
      </div>
      <div>
        <h2 class="section-title !text-xl">Data and caveats</h2>
        <p>
          Soil moisture and rainfall are <strong class="text-stone-800 dark:text-stone-200">model estimates</strong>, not measurements. They come from the land-surface
          component of the numerical weather prediction models that Open-Meteo combines for Italy, with a resolution of a few kilometres. They are useful for
          regional patterns and trends, but they do not replace local monitoring or field data. The last day is the model's estimate for today.
        </p>
        <p class="mt-3">
          {updated ? <>Last updated: {updated} (Italian time). </> : null}
          Weather data by <a class="link" href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo.com</a> (CC BY 4.0).
          Municipal boundaries: <a class="link" href="https://github.com/openpolis/geojson-italy" target="_blank" rel="noopener">Openpolis</a>, based on ISTAT data (CC BY 4.0).
          The data are downloaded once a day by the website's build process, so your browser does not contact any third-party service.
        </p>
      </div>
    </section>
  </BottomLayout>
</PageLayout>
