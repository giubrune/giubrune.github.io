---
// Software: one entry per file in src/content/software/.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications } from '../lib/publications';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
const tools = await Promise.all(
  (await getCollection('software'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (s) => ({
      ...s,
      Content: (await render(s)).Content,
      paper: publications.find((p) => p.key === s.data.paper),
    })),
);
---

<BaseLayout title={t('nav.software')} description={t('software.description')}>
  <div class="wrapper page">
    <h1>{t('nav.software')}</h1>
    <ul class="entries">
      {
        tools.map((s) => (
          <li id={s.id}>
            <p class="meta">{t(`software.kind.${s.data.kind}`)}</p>
            <h2 class="tool-name">{s.data.name}</h2>
            <p class="purpose">{s.data.purpose}</p>
            {s.data.figure && (
              <figure>
                <Image src={s.data.figure.image} alt={s.data.figure.alt} widths={[480, 960]} sizes="(min-width: 60rem) 40rem, 100vw" />
                {s.data.figure.caption && <figcaption class="meta">{s.data.figure.caption}</figcaption>}
              </figure>
            )}
            <div class="prose">
              <s.Content />
            </div>
            {s.data.links.length > 0 && (
              <ul class="link-row">
                {s.data.links.map((l) => (
                  <li>
                    <a href={l.url}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
            {s.paper && (
              <div class="cite">
                <p class="meta">{t('software.cite')}</p>
                <PublicationItem pub={s.paper} />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .entries > li {
    padding-block: var(--space-l);
  }

  .tool-name {
    font-size: var(--step-2);
    margin: var(--space-3xs) 0 var(--space-2xs);
  }

  .purpose {
    font-size: var(--step-1);
  }

  figure {
    margin: var(--space-m) 0;
    max-width: 40rem;
  }

  .link-row {
    margin-top: var(--space-s);
  }

  .cite {
    margin-top: var(--space-m);
    padding-left: var(--space-s);
    border-left: 2px solid var(--color-silt);
  }

  .cite > .meta {
    margin-bottom: var(--space-3xs);
  }
</style>
