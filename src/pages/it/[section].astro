---
// Temporary Italian pages for the sections that will have an Italian version.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { useTranslations } from '../../i18n/utils';

export const getStaticPaths = (() =>
  (['teaching', 'join'] as const).map((key) => ({ params: { section: key }, props: { key } }))) satisfies GetStaticPaths;

const t = useTranslations('it');
const heading = t(`nav.${Astro.props.key}`);
---

<BaseLayout title={heading}>
  <Placeholder heading={heading} />
</BaseLayout>
