---
import { type CollectionEntry, getCollection, render } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate } from "@lib/utils"

export async function getStaticPaths() {
  const posts = (await getCollection("news")).filter((n) => !n.data.draft)
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}
type Props = { entry: CollectionEntry<"news"> }
const { entry } = Astro.props
const { Content } = await render(entry)
---

<PageLayout title={entry.data.title} description={entry.data.summary}>
  <TopLayout>
    <a href="/news" class="text-sm link no-underline">← All news</a>
    <time class="mt-6 block text-sm text-stone-500" datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, "month")}</time>
    <h1 class="page-heading mt-1">{entry.data.title}</h1>
  </TopLayout>
  <BottomLayout>
    <article class="prose-article"><Content /></article>
  </BottomLayout>
</PageLayout>
