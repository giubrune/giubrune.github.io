---
// One research theme: text from src/content/research/<slug>.md, plus related publications
// (BibTeX keywords matching the theme’s tags), software and projects (their `themes` field).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { publications } from '../../lib/publications';
import { period } from '../../lib/format';
import { href } from '../../lib/url';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const themes = await getCollection('research');
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

interface Props {
  theme: CollectionEntry<'research'>;
}

const { theme } = Astro.props;
const t = useTranslations('en');
const { Content } = await render(theme);
const tags = new Set<string>(theme.data.tags);
const related = publications.filter((p) => p.tags.some((tag) => tags.has(tag)));
const software = (await getCollection('software'))
  .filter((s) => s.data.themes.some((r) => r.id === theme.id))
  .sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects'))
  .filter((p) => p.data.themes.some((r) => r.id === theme.id))
  .sort((a, b) => b.data.start - a.data.start);
---

<BaseLayout title={theme.data.title} description={theme.data.summary}>
  <article class="wrapper page">
    <p class="meta"><a href={href('/research/')}>{t('nav.research')}</a></p>
    <h1>{theme.data.title}</h1>
    <p class="lede">{theme.data.summary}</p>

    {
      theme.data.figure && (
        <figure>
          <Image src={theme.data.figure.image} alt={theme.data.figure.alt} widths={[640, 960, 1280]} sizes="(min-width: 72rem) 72rem, 100vw" />
          <figcaption>
            {theme.data.figure.caption}
            {theme.data.figure.credit && <span class="meta"> {theme.data.figure.credit}</span>}
          </figcaption>
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      theme.data.keyQuestions.length > 0 && (
        <section aria-labelledby="questions">
          <h2 id="questions" class="section-title">
            {t('research.questions')}
          </h2>
          <ul class="questions">
            {theme.data.keyQuestions.map((q) => (
              <li>{q}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      software.length > 0 && (
        <section aria-labelledby="software">
          <h2 id="software" class="section-title">
            {t('research.software')}
          </h2>
          <ul class="entries">
            {software.map((s) => (
              <li>
                <a href={href(`/software/#${s.id}`)}>{s.data.name}</a>
                <p class="meta">{s.data.purpose}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section aria-labelledby="projects">
          <h2 id="projects" class="section-title">
            {t('research.projects')}
          </h2>
          <ul class="entries">
            {projects.map((p) => (
              <li>
                <a href={href(`/projects/#${p.id}`)}>{p.data.acronym ? `${p.data.acronym}: ${p.data.title}` : p.data.title}</a>
                <p class="meta">
                  {p.data.role}, {p.data.funder}, {period(p.data.start, p.data.end)}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="pubs">
          <h2 id="pubs" class="section-title">
            {t('research.publications')}
          </h2>
          <ul class="entries">
            {related.map((p) => (
              <li>
                <PublicationItem pub={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .page > .meta {
    margin-bottom: var(--space-2xs);
  }

  figure {
    margin: var(--space-l) 0;
  }

  figcaption {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    max-width: 75ch;
  }

  .questions li {
    margin-bottom: var(--space-2xs);
  }
</style>
