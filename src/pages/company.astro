---
// The spin-off company, from src/content/company/index.md. Uses the root-green accent.
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
const company = await getEntry('company', 'index');
const { Content } = company ? await render(company) : { Content: null };
const d = company?.data;
---

<BaseLayout title={t('nav.company')} description={d?.tagline}>
  <div class="wrapper page company">
    {d?.logo && <Image class="logo" src={d.logo} alt={d.name} height={64} />}
    <h1>{d?.name ?? t('nav.company')}</h1>
    {d?.tagline && <p class="lede">{d.tagline}</p>}
    {Content && <div class="prose"><Content /></div>}
    {d?.website && <p class="website"><a href={d.website}>{t('company.website')}</a></p>}

    {
      d && d.services.length > 0 && (
        <section aria-labelledby="services">
          <h2 id="services" class="section-title">
            {t('company.services')}
          </h2>
          <ul class="entries">
            {d.services.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d && d.caseStudies.length > 0 && (
        <section aria-labelledby="cases">
          <h2 id="cases" class="section-title">
            {t('company.cases')}
          </h2>
          <ul class="entries">
            {d.caseStudies.map((c) => (
              <li>
                <h3>{c.url ? <a href={c.url}>{c.title}</a> : c.title}</h3>
                <p>{c.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d && d.team.length > 0 && (
        <section aria-labelledby="team">
          <h2 id="team" class="section-title">
            {t('company.team')}
          </h2>
          <ul class="entries">
            {d.team.map((m) => (
              <li>
                <h3>{m.name}</h3>
                <p class="meta">{m.role}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .company {
    border-top: 4px solid var(--color-root);
  }

  .company :global(a) {
    color: var(--color-root);
  }

  .logo {
    display: block;
    width: auto;
    margin-bottom: var(--space-m);
  }

  .website {
    font-family: var(--font-ui);
  }
</style>
