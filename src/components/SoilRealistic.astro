---
// Design alternative (variants A and C on /design-preview/): a realistic soil profile with
// stronger horizon colours, stones, roots, macropores and pores cut by the section.
//   mode "a": the infiltrated water as a clear blue tint with a sharp wetting front.
//   mode "c": plants on the surface; the water as a vivid water-content gradient with
//             preferential flow along macropores; a solute carried by the water and taken
//             up by the plants. Animated by the script below when a [data-soil-play]
//             button is pressed; otherwise the finished picture is shown.
// Decorative: hidden from screen readers.
import { WIDTH, HEIGHT, WATER_TABLE, profile } from '../lib/soil-profile';
import { stones, macroporePaths, cutPores } from '../lib/soil-extras';
import { waterOverlayImage } from '../lib/soil-field';
import { plants, PLANT_TOP } from '../lib/soil-plants';
import { solutes, solutesData } from '../lib/soil-solutes';

interface Props {
  id: string;
  mode: 'a' | 'c';
}

const { id, mode } = Astro.props;
const { tiles } = profile;
const wtX = WIDTH / 2 + 230;
const c = mode === 'c';
const top = c ? PLANT_TOP - 10 : 0;
const viewH = HEIGHT - top;
const water = c
  ? {
      groundwater: waterOverlayImage('groundwater'),
      matrix: waterOverlayImage('matrix'),
      macropores: waterOverlayImage('macropores'),
    }
  : null;
---

<svg
  id={id}
  class:list={['soil-real', `mode-${mode}`]}
  viewBox={`0 ${top} ${WIDTH} ${viewH}`}
  preserveAspectRatio="xMidYMin slice"
  aria-hidden="true"
  focusable="false"
  data-soil-anim={c ? JSON.stringify({ top, height: viewH, waterTable: WATER_TABLE }) : undefined}
>
  <defs>
    <pattern id={`${id}-fine`} width={tiles.fine.w} height={tiles.fine.h} patternUnits="userSpaceOnUse">
      {tiles.fine.grains.map((g, i) => <circle class={i % 3 ? 'g-top-dark' : 'g-top-light'} cx={g.cx} cy={g.cy} r={g.rx} />)}
    </pattern>
    <pattern id={`${id}-dense`} width={tiles.dense.w} height={tiles.dense.h} patternUnits="userSpaceOnUse">
      {tiles.dense.grains.map((g, i) => <circle class={i % 4 ? 'g-sub' : 'g-sub-light'} cx={g.cx} cy={g.cy} r={g.rx} />)}
    </pattern>
    <pattern id={`${id}-coarse`} width={tiles.coarse.w} height={tiles.coarse.h} patternUnits="userSpaceOnUse">
      {
        tiles.coarse.grains.map((g) => (
          <ellipse class="pebble" cx={g.cx} cy={g.cy} rx={g.rx} ry={g.ry} transform={`rotate(${g.rot} ${g.cx} ${g.cy})`} />
        ))
      }
    </pattern>
    <clipPath id={`${id}-ground`}><path d={profile.ground} /></clipPath>
    <clipPath id={`${id}-sand`}><path d={profile.sand} /></clipPath>
    {
      c && (
        <>
          <linearGradient id={`${id}-feather`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" />
            <stop offset="1" stop-color="#000" />
          </linearGradient>
          {['matrix', 'macropores'].map((part) => (
            <mask id={`${id}-reveal-${part}`} maskUnits="userSpaceOnUse" x="0" y={top} width={WIDTH} height={viewH}>
              <rect data-reveal={part} x="0" y={top} width={WIDTH} height={viewH} fill="#fff" />
              <rect data-feather={part} x="0" y={HEIGHT} width={WIDTH} height="24" fill={`url(#${id}-feather)`} />
            </mask>
          ))}
        </>
      )
    }
  </defs>

  <!-- Horizons -->
  <path class="h-top" d={profile.topsoil} />
  <path d={profile.topsoil} fill={`url(#${id}-fine)`} />
  <path class="h-sub" d={profile.subsoil} />
  <path d={profile.subsoil} fill={`url(#${id}-dense)`} />
  <path class="h-sand" d={profile.sand} />
  <path d={profile.sand} fill={`url(#${id}-coarse)`} />

  <!-- Stones, pores, channels, roots -->
  {stones.map((s) => <path class:list={['stone', { large: s.large }]} d={s.d} />)}
  {cutPores.map((p) => <ellipse class="cut-pore" cx={p.cx} cy={p.cy} rx={p.rx} ry={p.ry} />)}
  {macroporePaths.map((m) => <path class="macropore" d={m.d} stroke-width={m.width} />)}
  {profile.roots.map((r) => <path class:list={['root', { branch: !r.main }]} d={r.d} />)}
  {c && plants.map((p) => p.roots.map((r) => <path class:list={['plant-root', { main: r.main }]} d={r.d} />))}

  <path class="boundary" d={profile.boundary1Line} />
  <path class="boundary" d={profile.boundary2Line} />

  <!-- Water -->
  {
    !c ? (
      <>
        <path class="wet" d={profile.wet} />
        <path class="wet-sand" d={profile.wet} clip-path={`url(#${id}-sand)`} />
        <path class="front" d={profile.frontLine} />
        <path class="saturated" d={profile.saturated} />
      </>
    ) : (
      <>
        <image clip-path={`url(#${id}-ground)`} href={water!.groundwater} x="0" y="0" width={WIDTH} height={HEIGHT} preserveAspectRatio="none" />
        <g mask={`url(#${id}-reveal-matrix)`}>
          <image clip-path={`url(#${id}-ground)`} href={water!.matrix} x="0" y="0" width={WIDTH} height={HEIGHT} preserveAspectRatio="none" />
        </g>
        <g mask={`url(#${id}-reveal-macropores)`}>
          <image clip-path={`url(#${id}-ground)`} href={water!.macropores} x="0" y="0" width={WIDTH} height={HEIGHT} preserveAspectRatio="none" />
          {macroporePaths
            .filter((m) => m.deep)
            .map((m) => (
              <path class="macropore-water" d={m.d} stroke-width={Math.max(1, m.width - 0.8)} />
            ))}
        </g>
      </>
    )
  }

  <path class="surface" d={profile.surfaceLine} />
  <line class="water-table" x1="0" y1={WATER_TABLE} x2={WIDTH} y2={WATER_TABLE} />
  <path class="wt-symbol" d={`M${wtX - 9} ${WATER_TABLE - 15} L${wtX + 9} ${WATER_TABLE - 15} L${wtX} ${WATER_TABLE - 3} Z`} />
  <line class="water-table" x1={wtX - 7} y1={WATER_TABLE + 6} x2={wtX + 7} y2={WATER_TABLE + 6} />
  <line class="water-table" x1={wtX - 4} y1={WATER_TABLE + 11} x2={wtX + 4} y2={WATER_TABLE + 11} />

  {
    c && (
      <>
        {plants.map((p) => (
          <g class="plant">
            <path class="stem" d={p.stem} />
            {p.leaves.map((l) => (
              <>
                <path class="leaf" d={l.d} />
                <path class="vein" d={l.vein} />
              </>
            ))}
            {p.fruits.map((f) => (
              <>
                <path class="stalk" d={f.stalk} />
                <circle class="fruit" cx={f.cx} cy={f.cy} r={f.r} />
              </>
            ))}
          </g>
        ))}

        <g class="solutes" data-solutes={JSON.stringify(solutesData)}>
          {solutes.map((s) => {
            const [x, y] = s.path[s.path.length - 1];
            return <circle class:list={['solute', s.kind]} cx={x} cy={y} r={s.kind === 'plant' ? 2.3 : 2.7} />;
          })}
        </g>
      </>
    )
  }
</svg>

<script>
  // Animation of variant C: water moves down (faster along macropores), the solute follows
  // more slowly, and the plants take it up. Runs for about 5 seconds when a button with
  // data-soil-play="<svg id>" is pressed. Without JavaScript the finished picture stays.
  const DURATION = 5000;

  type Track = { el: SVGCircleElement; t0: number; t1: number; pts: number[][]; len: number[]; kind: string };

  function prepare(svg: SVGSVGElement) {
    const cfg = JSON.parse(svg.dataset.soilAnim!);
    const group = svg.querySelector<SVGGElement>('.solutes')!;
    const data: number[][] = JSON.parse(group.dataset.solutes!);
    const circles = [...group.querySelectorAll<SVGCircleElement>('circle')];
    const tracks: Track[] = circles.map((el, i) => {
      const [t0, t1, ...flat] = data[i];
      const pts: number[][] = [];
      for (let k = 0; k < flat.length; k += 2) pts.push([flat[k], flat[k + 1]]);
      const len = [0];
      for (let k = 1; k < pts.length; k++) len.push(len[k - 1] + Math.hypot(pts[k][0] - pts[k - 1][0], pts[k][1] - pts[k - 1][1]));
      const kind = el.classList.contains('plant') ? 'plant' : el.classList.contains('macropore') ? 'macropore' : 'matrix';
      return { el, t0, t1, pts, len, kind };
    });
    const reveal = (part: string) => ({
      solid: svg.querySelector<SVGRectElement>(`[data-reveal="${part}"]`)!,
      feather: svg.querySelector<SVGRectElement>(`[data-feather="${part}"]`)!,
    });
    return { cfg, tracks, matrix: reveal('matrix'), macropores: reveal('macropores') };
  }

  const clamp = (v: number) => Math.max(0, Math.min(1, v));

  function at(tr: Track, f: number) {
    const target = f * tr.len[tr.len.length - 1];
    let k = 1;
    while (k < tr.len.length - 1 && tr.len[k] < target) k++;
    const seg = tr.len[k] - tr.len[k - 1] || 1;
    const u = clamp((target - tr.len[k - 1]) / seg);
    const [a, b] = [tr.pts[k - 1], tr.pts[k]];
    return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u];
  }

  function play(svg: SVGSVGElement) {
    const s = prepare(svg);
    const { top } = s.cfg;
    const setReveal = (r: { solid: SVGRectElement; feather: SVGRectElement }, depth: number) => {
      r.solid.setAttribute('height', String(Math.max(0, depth - top)));
      r.feather.setAttribute('y', String(depth));
    };
    const start = performance.now();
    const frame = (now: number) => {
      const t = clamp((now - start) / DURATION);
      // Water: matrix front to ~1/3 of the profile, macropores down to the water table.
      setReveal(s.matrix, top + (110 - top) * clamp((t - 0.02) / 0.5) ** 0.6);
      setReveal(s.macropores, top + (s.cfg.waterTable + 30 - top) * clamp((t - 0.05) / 0.42));
      for (const tr of s.tracks) {
        const u = clamp((t - tr.t0) / (tr.t1 - tr.t0));
        const e = tr.kind === 'matrix' ? 1 - (1 - u) ** 2 : tr.kind === 'plant' ? u * u * (3 - 2 * u) : u;
        const [x, y] = at(tr, e);
        tr.el.setAttribute('cx', x.toFixed(1));
        tr.el.setAttribute('cy', y.toFixed(1));
        tr.el.style.opacity = t < tr.t0 ? '0' : String(clamp((t - tr.t0) / 0.03));
      }
      if (t < 1) requestAnimationFrame(frame);
      else {
        setReveal(s.matrix, s.cfg.height + top + 40);
        setReveal(s.macropores, s.cfg.height + top + 40);
      }
    };
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-soil-play]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const svg = document.getElementById(btn.dataset.soilPlay!) as SVGSVGElement | null;
      if (svg) play(svg);
    });
  });
</script>

<style>
  .soil-real {
    /* Realistic soil colours: the same in light and dark mode. */
    --top: #5f4a33;
    --top-grain-dark: #3f3022;
    --top-grain-light: #8c7252;
    --sub: #a5784b;
    --sub-grain: #7f5934;
    --sub-grain-light: #c69a68;
    --sand: #d8c69c;
    --pebble: #e7dab9;
    --pebble-edge: #a8916a;
    --stone: #9a958a;
    --stone-large: #85806f;
    --stone-edge: #5b574d;
    --pore: #24190f;
    --root: #e3d2aa;
    --water: #2a86d1;
    --water-deep: #1866b4;
    --stem: #3f5a37;
    --leaf: #6b9a55;
    --leaf-light: #84b06b;
    --fruit: #c8463a;
    --fruit-edge: #7a2a22;
    --solute: #f39a2b;
    --solute-edge: #6b3a00;

    display: block;
    width: 100%;
    height: max(clamp(220px, 30vw, 400px), 22.5vw);
  }

  /* With plants the drawing is taller (1600 × 555): keep the same rule, so nothing is cut off. */
  .soil-real.mode-c {
    height: max(clamp(290px, 40vw, 580px), 34.7vw);
  }

  .h-top { fill: var(--top); }
  .h-sub { fill: var(--sub); }
  .h-sand { fill: var(--sand); }

  .g-top-dark { fill: var(--top-grain-dark); }
  .g-top-light { fill: var(--top-grain-light); }
  .g-sub { fill: var(--sub-grain); opacity: 0.8; }
  .g-sub-light { fill: var(--sub-grain-light); }
  .pebble {
    fill: var(--pebble);
    stroke: var(--pebble-edge);
    stroke-width: 1.2;
  }

  .stone {
    fill: var(--stone);
    stroke: var(--stone-edge);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .stone.large { fill: var(--stone-large); }

  .cut-pore { fill: var(--pore); opacity: 0.85; }

  .macropore {
    fill: none;
    stroke: var(--pore);
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.9;
  }

  .macropore-water {
    fill: none;
    stroke: var(--water-deep);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .root,
  .plant-root {
    fill: none;
    stroke: var(--root);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .root { stroke-width: 1.5; opacity: 0.85; }
  .root.branch { stroke-width: 0.9; }
  .plant-root { stroke-width: 1.3; opacity: 0.95; }
  .plant-root.main { stroke-width: 2.2; }

  .boundary {
    fill: none;
    stroke: var(--top-grain-dark);
    stroke-width: 1;
    opacity: 0.35;
  }

  .surface {
    fill: none;
    stroke: var(--top-grain-dark);
    stroke-width: 3;
  }

  /* Light tint over the darker horizons, so their colours stay readable; clear blue in the sand. */
  .wet { fill: var(--water); opacity: 0.12; }
  .wet-sand { fill: var(--water); opacity: 0.38; }
  .front {
    fill: none;
    stroke: var(--water-deep);
    stroke-width: 2;
  }
  .saturated { fill: var(--water); opacity: 0.6; }

  .water-table {
    stroke: var(--water-deep);
    stroke-width: 2.5;
  }
  .wt-symbol {
    fill: none;
    stroke: var(--water-deep);
    stroke-width: 1.8;
  }

  .stem {
    fill: none;
    stroke: var(--stem);
    stroke-width: 2.6;
    stroke-linecap: round;
  }
  .leaf {
    fill: var(--leaf);
    stroke: var(--stem);
    stroke-width: 0.8;
  }
  .leaf:nth-of-type(4n) { fill: var(--leaf-light); }
  .vein {
    fill: none;
    stroke: var(--stem);
    stroke-width: 0.7;
    opacity: 0.6;
  }
  .stalk {
    fill: none;
    stroke: var(--stem);
    stroke-width: 1.2;
  }
  .fruit {
    fill: var(--fruit);
    stroke: var(--fruit-edge);
    stroke-width: 1;
  }

  .solute {
    fill: var(--solute);
    stroke: var(--solute-edge);
    stroke-width: 0.7;
  }
</style>
