---
// Temporary page body for sections that are not built yet (phase 1 scaffold).
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  heading: string;
}

const t = useTranslations(getLang(Astro.url));
---

<div class="wrapper placeholder">
  <h1>{Astro.props.heading}</h1>
  <slot />
  <p>{t('placeholder.text')}</p>
</div>

<style>
  .placeholder {
    padding-block: var(--space-xl);
  }
</style>
