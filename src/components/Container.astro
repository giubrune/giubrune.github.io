---
import { cn } from "@lib/utils"
type Props = { size?: "sm" | "md" | "lg" | "wide" | "xl"; class?: string }
const { size = "lg", class: klass } = Astro.props
---
<div class={cn(
  "w-full mx-auto px-5 sm:px-6",
  size === "sm" && "max-w-screen-sm",
  size === "md" && "max-w-screen-md",
  size === "lg" && "max-w-4xl",
  size === "wide" && "max-w-6xl",
  size === "xl" && "max-w-screen-xl",
  klass,
)}>
  <slot/>
</div>
