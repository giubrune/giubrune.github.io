---
import type { Publication } from "@lib/publications"
import { citationLine, TOPICS, TYPE_LABEL } from "@lib/publications"
type Props = { pub: Publication; showTopics?: boolean }
const { pub, showTopics = true } = Astro.props
const authors = pub.authors
---
<li class="pub group py-4 border-b border-stone-200/80 dark:border-stone-800 last:border-0"
  data-year={pub.year} data-type={pub.type} data-topics={pub.topics.join(" ")}
  data-text={`${pub.title} ${pub.venue} ${authors.map((a) => a.last).join(" ")} ${pub.year}`.toLowerCase()}>
  <div class="font-serif text-[1.05rem] leading-snug text-stone-900 dark:text-stone-100">
    {pub.url ? <a href={pub.url} target="_blank" rel="noopener" class="hover:text-accent-700 dark:hover:text-accent-300">{pub.title}</a> : pub.title}
  </div>
  <div class="mt-1 text-sm text-stone-600 dark:text-stone-400">
    {authors.map((a, i) => (
      <Fragment>
        {a.isMe ? <strong class="font-semibold text-stone-900 dark:text-stone-100">{a.last}, {a.initials}</strong> : <span>{a.last}, {a.initials}</span>}
        {i < authors.length - 1 ? ", " : ""}
      </Fragment>
    ))}
  </div>
  <div class="mt-1 text-sm">
    <em class="text-stone-700 dark:text-stone-300">{citationLine(pub)}</em>
    <span class="text-stone-500"> ({pub.year})</span>
    {pub.type !== "article" && <span class="ml-2 chip">{TYPE_LABEL[pub.type] ?? pub.type}</span>}
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
    {pub.doi && (
      <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener" class="link font-mono">doi:{pub.doi}</a>
    )}
    <details class="inline-block">
      <summary class="cursor-pointer list-none text-stone-500 hover:text-accent-700 dark:hover:text-accent-300 select-none">[BibTeX]</summary>
      <pre class="mt-2 p-3 rounded-md bg-stone-100 dark:bg-stone-900 text-[11px] leading-relaxed overflow-x-auto whitespace-pre"><code>{pub.bibtex}</code></pre>
    </details>
    {showTopics && pub.topics.map((t) => <span class="chip">{TOPICS[t]}</span>)}
  </div>
</li>
