---
import { LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const section = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "")
---

<div id="drawer" class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col items-center justify-center lg:hidden bg-stone-50 dark:bg-stone-950 transition-[height] duration-300 ease-in-out">
  <nav class="flex flex-col items-center gap-1 text-lg" aria-label="Mobile">
    {[{ TEXT: "Home", HREF: "/" }, ...LINKS, { TEXT: "Search", HREF: "/search" }].map((LINK) => (
      <a href={LINK.HREF} class={cn("px-4 py-1.5 rounded-md font-serif",
        section === LINK.HREF ? "text-accent-700 dark:text-accent-300 font-semibold" : "text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white")}>
        {LINK.TEXT}
      </a>
    ))}
  </nav>
  <button id="drawer-theme-button" aria-label="Toggle light and dark theme" class="mt-6 btn">
    <svg class="size-4 stroke-current block dark:hidden"><use href="/ui.svg#sun"></use></svg>
    <svg class="size-4 stroke-current hidden dark:block"><use href="/ui.svg#moon"></use></svg>
    Theme
  </button>
</div>

<style>
  #drawer.open { height: 100%; }
</style>
