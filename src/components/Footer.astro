---
// Site footer. The wavy line on top is the “water table”, the bottom of the vadose zone.
import { profile, profileLinks } from '../lib/profile';
import { sections } from '../i18n/ui';
import { getLang, useTranslations, localizedHref } from '../i18n/utils';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <svg class="water-table" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 6 Q 75 1 150 6 T 300 6 T 450 6 T 600 6 T 750 6 T 900 6 T 1050 6 T 1200 6"></path>
  </svg>
  <div class="wrapper grid">
    <section>
      <h2>{t('footer.contact')}</h2>
      <p>
        {profile.name}<br />
        {profile.role[lang]}<br />
        {profile.department[lang]}, {profile.institution[lang]}<br />
        {profile.city}
      </p>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </section>

    <nav aria-label={t('footer.sections')}>
      <h2>{t('footer.sections')}</h2>
      <ul>
        {sections.map((s) => <li><a href={localizedHref(s.path, lang)}>{t(`nav.${s.key}`)}</a></li>)}
      </ul>
    </nav>

    {
      profileLinks.length > 0 && (
        <section>
          <h2>{t('footer.profiles')}</h2>
          <ul>
            {profileLinks.map((p) => <li><a href={p.url} rel="me">{p.label}</a></li>)}
          </ul>
        </section>
      )
    }
  </div>
  <p class="wrapper copyright">© {year} {profile.name}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    padding-bottom: var(--space-l);
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .water-table {
    display: block;
    width: 100%;
    height: 12px;
    margin-top: -6px;
  }

  .water-table path {
    fill: none;
    stroke: var(--color-water-table);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-l);
    padding-top: var(--space-l);
  }

  h2 {
    font-size: var(--step-0);
    margin: 0 0 var(--space-xs);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-m);
  }

  li {
    padding-block: var(--space-3xs);
  }

  .copyright {
    margin-top: var(--space-l);
    color: var(--color-text-muted);
  }
</style>
