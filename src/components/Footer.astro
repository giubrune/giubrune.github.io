---
import { SITE } from "@consts"
import Container from "@components/Container.astro"
import SocialLinks from "@components/SocialLinks.astro"
const year = new Date().getFullYear()
---

<footer class="mt-16 border-t border-stone-200 dark:border-stone-800">
  <Container size="xl">
    <div class="py-8 flex flex-col sm:flex-row gap-6 sm:items-center justify-between">
      <div class="text-sm">
        <div class="font-serif font-semibold text-stone-900 dark:text-stone-100">{SITE.AUTHOR}</div>
        <div class="text-stone-500 dark:text-stone-400">{SITE.AFFILIATION}<br/>Rende, Italy</div>
      </div>
      <SocialLinks />
    </div>
    <div class="pb-8 text-xs text-stone-500 dark:text-stone-500 flex flex-wrap gap-x-4 gap-y-1">
      <span>&copy; {year} {SITE.AUTHOR}</span>
      <a href="/legal/privacy" class="hover:text-stone-800 dark:hover:text-stone-300">Privacy</a>
      <a href="/rss.xml" class="hover:text-stone-800 dark:hover:text-stone-300">RSS</a>
      <span>Built with Astro</span>
    </div>
  </Container>
</footer>
