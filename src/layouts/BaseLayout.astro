---
// Page shell used by every page: <head> metadata, header, main content, footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../lib/profile';
import { getLang, pathWithoutLang, localizedHref } from '../i18n/utils';
import { translatedPaths, languages, type Lang } from '../i18n/ui';
import { href } from '../lib/url';

interface Props {
  /** Page title; the site owner’s name is added after it. Leave out on the home page. */
  title?: string;
  /** Text for search engines and link previews. Defaults to the profile description. */
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLang(Astro.url);
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const pageDescription = description ?? profile.description[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);

const path = pathWithoutLang(Astro.url);
const alternates = translatedPaths.includes(path)
  ? (Object.keys(languages) as Lang[]).map((l) => ({
      lang: l,
      url: new URL(localizedHref(path, l), Astro.site),
    }))
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].url} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f5f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11191e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
