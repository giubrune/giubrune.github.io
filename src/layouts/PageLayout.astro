---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import { SITE } from "@consts"
type Props = { title: string; description: string; image?: string; jsonLd?: Record<string, unknown> }
const { title, description, image, jsonLd } = Astro.props
const fullTitle = title === SITE.TITLE ? title : `${title} | ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] btn bg-white">Skip to content</a>
    <Header />
    <Drawer />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
